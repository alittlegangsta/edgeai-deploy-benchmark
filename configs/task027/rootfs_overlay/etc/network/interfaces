# Task 027 persistent DR1 runtime profile.
# The address is intentionally static: this image is reached over the isolated
# 192.168.50.0/24 lab network and does not require a default route.
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 192.168.50.2
    netmask 255.255.255.0
